---
import IconHeart from "@/assets/icons/IconHeart.svg";

type Props = {
  endpoint?: string;
  label?: string;
};

// 线上走同域的 Pages Function 代理（workers.dev 在国内被墙）；
// 本地开发直连 worker，需要开代理。
const defaultEndpoint = import.meta.env.DEV
  ? "https://my-blog-likes.delta2024.workers.dev"
  : `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}api/likes`;

const { endpoint = defaultEndpoint, label = "Like this site" } = Astro.props;
---

<div
  id="like-widget"
  data-endpoint={endpoint}
  data-liked="false"
  class="fixed inset-e-16 top-4 z-50 flex w-fit flex-col items-center gap-1.5 max-lg:top-24"
>
  <button
    id="like-btn"
    type="button"
    aria-label={label}
    title={label}
    class="group border-border bg-background text-muted-foreground hover:text-accent hover:border-accent relative flex size-10 items-center justify-center rounded-full border shadow-sm transition duration-200 active:scale-90"
  >
    <IconHeart
      id="like-icon"
      class="size-6 transition-transform duration-300 group-hover:scale-110"
    />
  </button>
  <span
    id="like-count"
    class="text-muted-foreground text-xs tabular-nums"
    aria-live="polite"
  >
    —
  </span>
</div>

<style>
  :global(.like-plus-one) {
    position: absolute;
    top: 0;
    left: 50%;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1;
    pointer-events: none;
    user-select: none;
    will-change: transform, opacity;
  }

  #like-widget[data-liked="true"] #like-icon {
    color: var(--color-accent);
    fill: var(--color-accent);
    stroke: var(--color-accent);
  }
</style>

<script>
  const LIKE_STORAGE_KEY = "liked-site";

  function initLikeWidget() {
    const widget = document.getElementById("like-widget") as HTMLElement | null;
    const button = document.getElementById("like-btn") as HTMLButtonElement | null;
    const countEl = document.getElementById("like-count") as HTMLElement | null;
    const icon = document.getElementById("like-icon") as SVGElement | null;

    if (!widget || !button || !countEl || !icon) return;
    if (widget.dataset.bound) return;
    widget.dataset.bound = "true";

    const widgetEl: HTMLElement = widget;
    const buttonEl: HTMLButtonElement = button;
    const countElement: HTMLElement = countEl;
    const iconEl: SVGElement = icon;

    const endpoint = widgetEl.dataset.endpoint ?? "";
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    let count = 0;
    let ready = false;
    let busy = false;

    if (localStorage.getItem(LIKE_STORAGE_KEY) === "1") {
      widgetEl.dataset.liked = "true";
    }

    function render() {
      countElement.textContent = count.toLocaleString();
    }

    function spawnPlusOne() {
      const plus = document.createElement("span");
      plus.textContent = "+1";
      plus.className = "like-plus-one";
      plus.setAttribute("aria-hidden", "true");
      widgetEl.appendChild(plus);

      const animation = plus.animate(
        [
          { transform: "translate(-50%, 4px) scale(0.6)", opacity: 0 },
          {
            transform: "translate(-50%, -10px) scale(1)",
            opacity: 1,
            offset: 0.25,
          },
          { transform: "translate(-50%, -52px) scale(1)", opacity: 0 },
        ],
        {
          duration: 900,
          easing: "cubic-bezier(0.22, 1, 0.36, 1)",
        }
      );

      animation.onfinish = () => plus.remove();
      if (reduceMotion) animation.finish();
    }

    function popIcon() {
      if (reduceMotion) return;
      iconEl.animate(
        [
          { transform: "scale(1)" },
          { transform: "scale(1.35)", offset: 0.35 },
          { transform: "scale(0.9)", offset: 0.7 },
          { transform: "scale(1)" },
        ],
        { duration: 420, easing: "cubic-bezier(0.34, 1.56, 0.64, 1)" }
      );
    }

    async function loadCount() {
      try {
        const res = await fetch(`${endpoint}?t=${Date.now()}`, {
          headers: { Accept: "application/json" },
          cache: "no-store",
        });
        if (!res.ok) throw new Error(String(res.status));
        const data = (await res.json()) as { likes?: number };
        if (typeof data.likes === "number") {
          count = data.likes;
          ready = true;
          render();
        }
      } catch (err) {
        // eslint-disable-next-line no-console
        console.error("[like] loadCount failed:", err);
        countElement.textContent = "—";
      }
    }

    async function like() {
      if (busy) return;
      busy = true;

      widgetEl.dataset.liked = "true";
      localStorage.setItem(LIKE_STORAGE_KEY, "1");
      count += 1;
      render();
      spawnPlusOne();
      popIcon();

      try {
        const res = await fetch(`${endpoint}?t=${Date.now()}`, {
          method: "POST",
          headers: { Accept: "application/json" },
          cache: "no-store",
        });
        if (!res.ok) throw new Error(String(res.status));
        const data = (await res.json()) as { likes?: number };
        if (typeof data.likes === "number") {
          count = data.likes;
          ready = true;
          render();
        }
      } catch (err) {
        // eslint-disable-next-line no-console
        console.error("[like] POST failed:", err);
        count = ready ? count - 1 : 0;
        render();
      } finally {
        busy = false;
      }
    }

    buttonEl.addEventListener("click", like);
    loadCount();
  }

  initLikeWidget();
  document.addEventListener("astro:after-swap", initLikeWidget);
</script>
